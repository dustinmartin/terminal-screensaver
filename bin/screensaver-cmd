#!/bin/bash
# Core screensaver loop - runs TTE effects until input detected

export PATH="$HOME/.local/bin:$PATH"

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCREENSAVER_TXT="$SCRIPT_DIR/config/screensaver.txt"
MAX_EFFECT_SECONDS=${SCREENSAVER_EFFECT_TIMEOUT_SECONDS:-120}
if ! [[ "$MAX_EFFECT_SECONDS" =~ ^[0-9]+$ ]]; then
  MAX_EFFECT_SECONDS=120
fi
TTE_PID=""
ORIGINAL_STTY=""
CLEANED_UP=0

if [[ -t 0 ]]; then
  ORIGINAL_STTY=$(stty -g 2>/dev/null || true)
  stty -echo -icanon time 0 min 0 2>/dev/null || true
fi

wait_for_tte() {
  local pid=${TTE_PID:-}
  [[ -z "$pid" ]] && return 0

  wait "$pid" 2>/dev/null || true
  TTE_PID=""
}

stop_tte() {
  local pid=${TTE_PID:-}
  [[ -z "$pid" ]] && return 0

  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    for _ in {1..10}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi

  wait_for_tte
}

drain_input() {
  while IFS= read -r -s -n 1 -t 0.01; do
    :
  done
}

cleanup() {
  (( CLEANED_UP )) && return 0
  CLEANED_UP=1

  stop_tte
  printf '\e[?1000l\e[?1003l' # Disable mouse tracking
  printf '\e[?25h'            # Show cursor
  if [[ -n "$ORIGINAL_STTY" ]]; then
    stty "$ORIGINAL_STTY" 2>/dev/null || true
  fi
}

exit_screensaver() {
  cleanup
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT
trap cleanup EXIT

printf '\033]11;rgb:00/00/00\007'  # Black background
printf '\e[?25l'                    # Hide cursor
printf '\e[?1000h\e[?1003h'        # Enable mouse tracking

# Ignore input for the first 2 seconds (window creation and focus events
# generate mouse tracking data that would otherwise cause an immediate exit)
GRACE_END=$(( SECONDS + 2 ))

while true; do
  clear
  tte -i "$SCREENSAVER_TXT" \
    --frame-rate 30 --canvas-width 0 --canvas-height 0 \
    --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor &
  TTE_PID=$!
  EFFECT_STARTED=$SECONDS

  while [[ -n "$TTE_PID" ]] && kill -0 "$TTE_PID" 2>/dev/null; do
    if IFS= read -r -s -n 1 -t 0.1; then
      if (( SECONDS >= GRACE_END )); then
        exit_screensaver
      fi
      drain_input
    fi

    if (( MAX_EFFECT_SECONDS > 0 && SECONDS - EFFECT_STARTED >= MAX_EFFECT_SECONDS )); then
      stop_tte
      break
    fi
  done

  wait_for_tte
done
