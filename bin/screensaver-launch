#!/bin/bash
# Launch screensaver - one fullscreen Alacritty per monitor

export PATH="$HOME/.local/bin:$PATH"

if ! command -v tte &>/dev/null; then
  echo "tte not found. Install: pipx install terminaltexteffects" >&2
  exit 1
fi

# Use a lock file to prevent concurrent instances (kernel releases on process exit)
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/screensaver.lock"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
STATE_FILE=~/.local/state/screensaver/toggles/screensaver-off

if [[ -f "$STATE_FILE" ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Save current Do Not Disturb state and enable it to suppress notification banners
PREV_SHOW_BANNERS=$(gsettings get org.gnome.desktop.notifications show-banners 2>/dev/null)
gsettings set org.gnome.desktop.notifications show-banners false 2>/dev/null

PIDS=()
SETSID_BIN=$(command -v setsid || true)
CLEANED_UP=0
WATCHDOG_PID=""
MAX_SESSION_SECONDS=${SCREENSAVER_SESSION_TIMEOUT_SECONDS:-3600}
if ! [[ "$MAX_SESSION_SECONDS" =~ ^[0-9]+$ ]]; then
  MAX_SESSION_SECONDS=3600
fi

cleanup() {
  (( CLEANED_UP )) && return 0
  CLEANED_UP=1

  if [[ -n "$WATCHDOG_PID" ]]; then
    kill "$WATCHDOG_PID" 2>/dev/null || true
    wait "$WATCHDOG_PID" 2>/dev/null || true
  fi

  if [[ -n "$PREV_SHOW_BANNERS" ]]; then
    gsettings set org.gnome.desktop.notifications show-banners "$PREV_SHOW_BANNERS" 2>/dev/null
  fi

  for pid in "${PIDS[@]}"; do
    if [[ -n "$SETSID_BIN" ]]; then
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    else
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done

  for _ in {1..30}; do
    local any_alive=0
    for pid in "${PIDS[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        any_alive=1
        break
      fi
    done
    (( any_alive )) || break
    sleep 0.1
  done

  for pid in "${PIDS[@]}"; do
    if kill -0 "$pid" 2>/dev/null; then
      if [[ -n "$SETSID_BIN" ]]; then
        kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
      else
        kill -KILL "$pid" 2>/dev/null || true
      fi
    fi
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT
trap 'cleanup; exit 0' SIGINT SIGTERM SIGHUP SIGQUIT

MONITOR_COUNT=$(xrandr --listmonitors 2>/dev/null | awk '/^ / { count++ } END { print (count > 0 ? count : 1) }')

if (( MAX_SESSION_SECONDS > 0 )); then
  (
    sleep "$MAX_SESSION_SECONDS"
    kill -TERM "$$" 2>/dev/null || true
  ) &
  WATCHDOG_PID=$!
fi

for i in $(seq 1 "$MONITOR_COUNT"); do
  if [[ -n "$SETSID_BIN" ]]; then
    "$SETSID_BIN" alacritty \
      --title "Terminal Screensaver" \
      --class "terminal-screensaver,terminal-screensaver" \
      --config-file "$SCRIPT_DIR/config/alacritty-screensaver.toml" \
      -e "$SCRIPT_DIR/bin/screensaver-cmd" &
  else
    alacritty \
      --title "Terminal Screensaver" \
      --class "terminal-screensaver,terminal-screensaver" \
      --config-file "$SCRIPT_DIR/config/alacritty-screensaver.toml" \
      -e "$SCRIPT_DIR/bin/screensaver-cmd" &
  fi
  PIDS+=($!)
done

wait -n "${PIDS[@]}" 2>/dev/null || true
cleanup
